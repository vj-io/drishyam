# Names only. Never commit values: .env* is git-ignored except this file.
# Every variable is optional for a local run; the comments say what each one changes. Delete the lines you do
# not set: an empty value counts as set (an empty DRISHYAM_PIXEL_CAP, say, makes the MCP server refuse to start a job).

# Work-order signing key, >= 32 characters. Deployed instances refuse to start without one.
DRISHYAM_SIGNING_KEY=
# AWS only: the Secrets Manager secret holding that key (its SecretString is the key), read once at cold start.
DRISHYAM_SIGNING_KEY_SECRET_ARN=
# AWS only: DynamoDB table for KILL flags (partition key k, TTL attribute exp). Unset: kept in this process.
DRISHYAM_KILL_TABLE=

# Operator-wide stop: 1 halts every job; or the flag file `drishyam kill` creates (default ~/.drishyam/KILL).
DRISHYAM_KILL_SWITCH=
DRISHYAM_KILL_FILE=

# Segmenter: an ONNX model (scripts/install_model.sh), optional FP16 twin. Unset: classical-v1.
DRISHYAM_ONNX=
DRISHYAM_ONNX_FP16=

# Optional LLM planner, any OpenAI-compatible endpoint (https, or http to loopback). Unset: rule planner only.
DRISHYAM_PLANNER_URL=
DRISHYAM_PLANNER_MODEL=
DRISHYAM_PLANNER_KEY=

# Build provenance shown by /api/health (scripts/aws.sh deploy sets it on the function).
DRISHYAM_COMMIT=

# MCP server: starting caps (the model can only lower them), image roots, run folder.
DRISHYAM_PIXEL_CAP=
DRISHYAM_USD_CAP=
DRISHYAM_SECONDS_CAP=
DRISHYAM_IMAGE_ROOT=
DRISHYAM_RUNS_DIR=

# Local dev and e2e only: serve public/ from the API process.
DRISHYAM_SERVE_STATIC=
